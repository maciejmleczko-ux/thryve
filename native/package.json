{
  "name": "mekkio-native",
  "private": true,
  "description": "Capacitor shell for Mekkio (iOS). Web app lives in ../index.html.",
  "scripts": {
    "web": "sh ../scripts/build-web.sh && rm -rf www && cp -R ../dist www",
