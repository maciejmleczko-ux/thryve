// Cloudflare Workers (static assets) for app.mekkio.app.
// Build: `sh scripts/build-web.sh` fills dist/ with the app files only;
// deploy: `npx wrangler deploy` (Workers Builds runs both on every push to main).
{
  "name": "mekkio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  }
}
